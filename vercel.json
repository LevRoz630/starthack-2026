{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,web/**,data/core-case/**,data/outlook/**,data/profiles/**,data/translations/**,data/scenarios/**,data/playbook.json,data/excustody/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}